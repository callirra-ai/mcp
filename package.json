  "description": "Callirra MCP server: generate images and video from any MCP-compatible agent, browse 172 curated prompt recipes, and use one API key for the newest image and video models.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "callirra-mcp": "./dist/index.js"
  },
